# Django Server Configuration
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-omnichat-ai-observability-system-key-2026

# AI Dynamic Generation Configuration
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Set USE_MYSQL=True when running MySQL server)
USE_MYSQL=False
DB_NAME=chatbot_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Cache Configuration (Set USE_REDIS=True when running Redis server)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1

# RAG & Observability Settings
CACHE_TTL_SECONDS=300
SIMILARITY_THRESHOLD=0.10
MAX_CONTEXT_CHUNKS=3
